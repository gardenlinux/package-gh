debian_version="2.46.0-4"
version_orig="2.46.0"
version="${version_orig}-4"
version_suffix=gl0~bp1877
DEBIAN_SRC=$(mktemp -d)

git clone -b "debian/${debian_version}" --depth=1 https://salsa.debian.org/go-team/packages/gh.git $DEBIAN_SRC

pushd $DEBIAN_SRC
git sparse-checkout set debian
popd
cp -rp "$DEBIAN_SRC/debian" "$dir/src/"
rm -fR "$DEBIAN_SRC"
git_src -b "v${version_orig}" https://github.com/cli/cli
